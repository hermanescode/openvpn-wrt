# Config 6: TCP 2083 (Cloudflare cPanel / HTTPS Port)
proto tcp-client
remote 91.107.169.119 2083
tcp-nodelay
tun-mtu 1350
mssfix 1250

cipher AES-128-GCM
data-ciphers AES-128-GCM:AES-256-GCM:CHACHA20-POLY1305
dev tun
client
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3

